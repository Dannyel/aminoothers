# Proxy público con HTTPS automático (Let's Encrypt). Solo el frontend (BFF)
# se expone; la API y PostgreSQL quedan en la red interna.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Comprobantes e imágenes: hasta 5 MB por archivo.
	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy frontend:3000
}

# Dominio con www: redirige al principal.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
