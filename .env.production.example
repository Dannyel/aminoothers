# Copiar a .env.production (nunca al repositorio) y completar. Lo lee
# docker compose -f docker-compose.prod.yml --env-file .env.production …

# Dominio público (sin https://) y correo para Let's Encrypt.
DOMAIN=farmacia.example.com
ACME_EMAIL=ti@example.com

# Base de datos. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Secretos de la API. Generar cada uno con: openssl rand -hex 32
# TOTP_ENCRYPTION_KEY cifra los secretos del doble factor: si se pierde o se
# cambia, todos los usuarios deben configurar de nuevo su app autenticadora.
JWT_ACCESS_SECRET=
TOTP_ENCRYPTION_KEY=
MFA_ISSUER=Farmacia en línea

# Correo (D9). El dominio del remitente necesita SPF, DKIM y DMARC.
MAIL_FROM="Farmacia en línea <no-responder@farmacia.example.com>"
SMTP_HOST=
SMTP_PORT=587
# true = TLS implícito (puerto 465); false = STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Primer superadministrador: solo se usa si aún no existe ninguno. Después del
# primer despliegue, vaciar INITIAL_ADMIN_PASSWORD.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Respaldos (D20): carpeta del servidor, hora (Guatemala) y copias conservadas.
BACKUP_PATH=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12
