# Copiar a .env. URL base del backend, sin /api/v1. Solo se usa en el servidor.
API_URL=http://localhost:3000

# Solo producción (node build). La imagen Docker ya los trae:
# BODY_SIZE_LIMIT=8M            # comprobantes e imágenes de hasta 5 MB (por defecto 512K → 413)
# PROTOCOL_HEADER=x-forwarded-proto
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
