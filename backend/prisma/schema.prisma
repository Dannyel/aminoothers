// Esquema de la farmacia en línea. Modelo de datos aprobado en
// docs/fase-1/02-modelo-de-datos.md; las tablas se agregan en la fase que las usa.
// Restricciones que Prisma no expresa (CHECK, índices parciales) viven en el SQL
// de cada migración.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuarios y seguridad ────────────────────────────────────────────────────

enum UserType {
  CUSTOMER
  STAFF

  @@map("user_type")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE

  @@map("user_status")
}

enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("user_token_purpose")
}

/// Cuenta de acceso de clientes y personal. Los tipos son excluyentes.
/// La baja es lógica mediante status = INACTIVE.
model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  email               String     @unique @db.Citext
  passwordHash        String     @map("password_hash")
  type                UserType
  status              UserStatus @default(ACTIVE)
  firstName           String     @map("first_name") @db.VarChar(100)
  lastName            String     @map("last_name") @db.VarChar(100)
  phone               String?    @db.VarChar(30)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Secreto TOTP cifrado (AES-256-GCM). Con totpEnabledAt nulo es una configuración en curso.
  totpSecret          String?    @map("totp_secret") @db.VarChar(255)
  totpEnabledAt       DateTime?  @map("totp_enabled_at") @db.Timestamptz(3)
  /// Último paso de tiempo TOTP aceptado; impide reutilizar un código.
  totpLastStep        Int?       @map("totp_last_step")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       Customer?
  roles          UserRole[]
  sessions       Session[]
  tokens         UserToken[]
  mfaChallenges  MfaChallenge[]
  recoveryCodes  RecoveryCode[]
  movements      InventoryMovement[]
  orderChanges   OrderStatusHistory[]
  paymentChanges PaymentStatusHistory[]
  auditLogs      AuditLog[]

  @@index([type, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// Los roles de sistema no se pueden eliminar; SUPER_ADMIN tampoco se edita.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catálogo fijo de permisos (`modulo.accion`), sincronizado desde el código.
model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique @db.VarChar(100)
  module      String @db.VarChar(50)
  description String @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Datos de cliente, 1:1 con un usuario de tipo CUSTOMER.
model Customer {
  userId    String    @id @map("user_id") @db.Uuid
  /// NIT para facturación; "CF" (consumidor final) por defecto.
  taxId     String    @default("CF") @map("tax_id") @db.VarChar(20)
  taxName   String?   @map("tax_name") @db.VarChar(200)
  birthDate DateTime? @map("birth_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses CustomerAddress[]
  cart      Cart?
  orders    Order[]

  @@map("customers")
}

model CustomerAddress {
  id            String    @id @default(uuid(7)) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  label         String    @db.VarChar(50)
  recipientName String    @map("recipient_name") @db.VarChar(150)
  phone         String    @db.VarChar(30)
  addressLine1  String    @map("address_line1") @db.VarChar(200)
  addressLine2  String?   @map("address_line2") @db.VarChar(200)
  zone          String?   @db.VarChar(20)
  municipality  String    @db.VarChar(100)
  department    String    @db.VarChar(50)
  reference     String?   @db.VarChar(300)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [userId], onDelete: Restrict)
  orders   Order[]

  // Índices parciales (activas por cliente; una sola predeterminada) en la migración SQL.
  @@map("customer_addresses")
}

/// Un registro por refresh token emitido. Todos los tokens de un inicio de
/// sesión comparten `familyId`; el access token lleva `sid = familyId`.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ip           String?   @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session?  @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session[] @relation("SessionRotation")

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}

/// Segundo paso del inicio de sesión: se crea tras validar la contraseña y se
/// consume al verificar el código TOTP. De un solo uso y con intentos limitados.
model MfaChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

/// Códigos de recuperación del doble factor (solo se guarda su hash).
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("user_recovery_codes")
}

// ─── Archivos ────────────────────────────────────────────────────────────────

enum FilePurpose {
  PRODUCT_IMAGE
  CATEGORY_IMAGE
  PAYMENT_PROOF
  PRESCRIPTION
  LOGO
  FEL_DOCUMENT

  @@map("file_purpose")
}

/// Archivo cargado. El contenido vive en el almacenamiento (disco local); aquí
/// solo los metadatos. Los privados se sirven únicamente con autorización.
model File {
  id           String      @id @default(uuid(7)) @db.Uuid
  storageKey   String      @unique @map("storage_key") @db.VarChar(255)
  originalName String      @map("original_name") @db.VarChar(255)
  mimeType     String      @map("mime_type") @db.VarChar(100)
  sizeBytes    Int         @map("size_bytes")
  sha256       String      @db.Char(64)
  purpose      FilePurpose
  isPublic     Boolean     @default(false) @map("is_public")
  uploadedById String?     @map("uploaded_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  productImages ProductImage[]
  categories    Category[]
  storeLogos    StoreSettings[]
  paymentProofs Payment[]

  @@map("files")
}

// ─── Impuestos (configuración completa en la Fase 8) ─────────────────────────

model TaxRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  /// Proporción: 0.1200 = 12 %.
  rate      Decimal  @db.Decimal(5, 4)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("tax_rates")
}

// ─── Catálogos ───────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  imageFileId String?   @map("image_file_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  image         File?         @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id         String    @id @default(uuid(7)) @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  name       String    @db.VarChar(100)
  slug       String    @db.VarChar(120)
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  /// Destino de la FK compuesta de products: la subcategoría debe ser de la categoría.
  @@unique([id, categoryId])
  @@map("subcategories")
}

model Brand {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(120)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

model Manufacturer {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @db.VarChar(170)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@map("manufacturers")
}

/// Forma de presentación: caja, blister, frasco, tableta, cápsula, tubo…
model Presentation {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(120)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@map("presentations")
}

/// Concentración mostrada al cliente: "500 mg", "5 %", "875 mg + 125 mg".
model Concentration {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(120)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@map("concentrations")
}

model ActiveIngredient {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @db.VarChar(170)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products ProductActiveIngredient[]

  @@map("active_ingredients")
}

model Tag {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(60)
  slug      String    @db.VarChar(80)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products ProductTag[]

  @@map("tags")
}

// ─── Productos ───────────────────────────────────────────────────────────────

enum SaleCondition {
  /// Venta libre.
  OTC
  /// Requiere receta médica.
  PRESCRIPTION
  /// Requiere receta que retiene la farmacia.
  RETAINED_PRESCRIPTION
  /// Controlado: nunca se vende en línea.
  CONTROLLED

  @@map("sale_condition")
}

model Product {
  id                            String        @id @default(uuid(7)) @db.Uuid
  sku                           String        @unique @db.VarChar(50)
  barcode                       String?       @db.VarChar(50)
  name                          String        @db.VarChar(200)
  slug                          String        @unique @db.VarChar(250)
  shortDescription              String?       @map("short_description") @db.VarChar(300)
  description                   String?
  categoryId                    String        @map("category_id") @db.Uuid
  subcategoryId                 String?       @map("subcategory_id") @db.Uuid
  brandId                       String?       @map("brand_id") @db.Uuid
  manufacturerId                String?       @map("manufacturer_id") @db.Uuid
  presentationId                String?       @map("presentation_id") @db.Uuid
  concentrationId               String?       @map("concentration_id") @db.Uuid
  sanitaryRegistration          String?       @map("sanitary_registration") @db.VarChar(100)
  sanitaryRegistrationExpiresAt DateTime?     @map("sanitary_registration_expires_at") @db.Date
  /// Precio único de venta, con IVA incluido (D1).
  price                         Decimal       @db.Decimal(12, 2)
  taxRateId                     String        @map("tax_rate_id") @db.Uuid
  saleCondition                 SaleCondition @default(OTC) @map("sale_condition")
  /// Habilitación regulatoria para vender en línea (registra quién y cuándo).
  onlineSaleEnabled             Boolean       @default(false) @map("online_sale_enabled")
  onlineSaleApprovedById        String?       @map("online_sale_approved_by") @db.Uuid
  onlineSaleApprovedAt          DateTime?     @map("online_sale_approved_at") @db.Timestamptz(3)
  lowStockThreshold             Int           @default(0) @map("low_stock_threshold")
  isActive                      Boolean       @default(true) @map("is_active")
  createdAt                     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                     DateTime?     @map("deleted_at") @db.Timestamptz(3)

  category          Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// FK compuesta (subcategory_id, category_id) → subcategories(id, category_id).
  subcategory       Subcategory?              @relation(fields: [subcategoryId, categoryId], references: [id, categoryId], onDelete: Restrict)
  brand             Brand?                    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  manufacturer      Manufacturer?             @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  presentation      Presentation?             @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  concentration     Concentration?            @relation(fields: [concentrationId], references: [id], onDelete: Restrict)
  taxRate           TaxRate                   @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  activeIngredients ProductActiveIngredient[]
  images            ProductImage[]
  tags              ProductTag[]
  lots              Lot[]
  purchaseItems     PurchaseOrderItem[]
  movements         InventoryMovement[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  promotions        PromotionProduct[]

  @@index([categoryId, isActive])
  @@index([subcategoryId])
  @@index([brandId])
  @@map("products")
}

model ProductActiveIngredient {
  productId          String @map("product_id") @db.Uuid
  activeIngredientId String @map("active_ingredient_id") @db.Uuid
  sortOrder          Int    @default(0) @map("sort_order")

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  activeIngredient ActiveIngredient @relation(fields: [activeIngredientId], references: [id], onDelete: Restrict)

  @@id([productId, activeIngredientId])
  @@index([activeIngredientId])
  @@map("product_active_ingredients")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ─── Configuración ───────────────────────────────────────────────────────────

/// Parámetros de la farmacia (fila única, id = 1). Cada fase agrega los suyos.
model StoreSettings {
  id                      Int @id @default(1)
  /// Lotes que vencen antes de hoy + estos días no se venden (D4).
  minShelfLifeDaysForSale Int @default(30) @map("min_shelf_life_days_for_sale")
  /// Umbral de alerta "próximo a vencer" (D4).
  nearExpiryDays          Int @default(90) @map("near_expiry_days")

  // Datos de la farmacia que muestra la tienda.
  tradeName        String  @default("Farmacia en línea") @map("trade_name") @db.VarChar(150)
  legalName        String? @map("legal_name") @db.VarChar(200)
  taxId            String? @map("tax_id") @db.VarChar(20)
  fiscalAddress    String? @map("fiscal_address") @db.VarChar(300)
  phone            String? @db.VarChar(30)
  whatsapp         String? @db.VarChar(30)
  email            String? @db.VarChar(254)
  businessHours    String? @map("business_hours") @db.VarChar(300)
  logoFileId       String? @map("logo_file_id") @db.Uuid
  // Información regulatoria (D19): el texto exacto lo provee el regente.
  sanitaryLicense  String? @map("sanitary_license") @db.VarChar(100)
  regentName       String? @map("regent_name") @db.VarChar(150)
  regulatoryNotice String  @default("La información de esta tienda no sustituye la consulta con un profesional de la salud.") @map("regulatory_notice") @db.VarChar(2000)

  // Pedidos.
  /// Horas para pagar un pedido por transferencia antes de liberar la reserva (D3).
  transferReservationHours Int @default(24) @map("transfer_reservation_hours")
  /// Horas para que el personal confirme un pedido contra entrega (D3).
  codReservationHours      Int @default(48) @map("cod_reservation_hours")
  /// Máximo de unidades de un mismo producto por pedido.
  maxUnitsPerProduct       Int @default(10) @map("max_units_per_product")
  /// Días desde la entrega para registrar una devolución (D7).
  returnWindowDays         Int @default(7) @map("return_window_days")

  // Notificaciones.
  /// Buzón del personal para comprobantes por verificar y alertas de inventario.
  staffAlertEmail String? @map("staff_alert_email") @db.VarChar(254)

  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  logo File? @relation(fields: [logoFileId], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

// ─── Inventario ──────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lots Lot[]

  @@map("warehouses")
}

enum LotStatus {
  AVAILABLE
  QUARANTINE
  /// Retiro del mercado.
  RECALLED
  BLOCKED

  @@map("lot_status")
}

/// Existencias por producto y lote. "Vencido" se calcula por fecha.
model Lot {
  id                String    @id @default(uuid(7)) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.Uuid
  lotNumber         String    @map("lot_number") @db.VarChar(50)
  /// Nula solo para productos que no vencen.
  expirationDate    DateTime? @map("expiration_date") @db.Date
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  status            LotStatus @default(AVAILABLE)
  statusReason      String?   @map("status_reason") @db.VarChar(300)
  qtyOnHand         Int       @default(0) @map("qty_on_hand")
  qtyReserved       Int       @default(0) @map("qty_reserved")
  /// Costo promedio ponderado de las entradas del lote.
  avgUnitCost       Decimal   @default(0) @map("avg_unit_cost") @db.Decimal(12, 4)
  firstReceivedAt   DateTime  @default(now()) @map("first_received_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]
  receiptItems PurchaseReceiptItem[]
  reservations StockReservation[]
  returnItems  ReturnItem[]

  @@unique([productId, lotNumber])
  @@index([productId, status, expirationDate])
  @@map("lots")
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_RESTOCK
  WRITE_OFF
  RETURN_TO_SUPPLIER

  @@map("movement_type")
}

/// Kardex inmutable (un trigger impide UPDATE y DELETE).
model InventoryMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  number        Int          @unique @default(autoincrement())
  lotId         String       @map("lot_id") @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  type          MovementType
  /// Con signo: positivo entra, negativo sale.
  quantity      Int
  balanceAfter  Int          @map("balance_after")
  unitCost      Decimal      @map("unit_cost") @db.Decimal(12, 4)
  reasonCode    String?      @map("reason_code") @db.VarChar(30)
  notes         String?      @db.VarChar(500)
  referenceType String?      @map("reference_type") @db.VarChar(30)
  referenceId   String?      @map("reference_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  lot     Lot     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  consumedReservation StockReservation?
  restockedReturnItem ReturnItem?

  @@index([lotId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
  @@map("inventory_movements")
}

// ─── Compras ─────────────────────────────────────────────────────────────────

model Supplier {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(200)
  taxId       String?   @map("tax_id") @db.VarChar(20)
  contactName String?   @map("contact_name") @db.VarChar(150)
  phone       String?   @db.VarChar(30)
  email       String?   @db.VarChar(254)
  address     String?   @db.VarChar(300)
  notes       String?   @db.VarChar(1000)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  /// Cerrada con faltante.
  CLOSED
  CANCELLED

  @@map("purchase_order_status")
}

model PurchaseOrder {
  id           String              @id @default(uuid(7)) @db.Uuid
  number       Int                 @unique @default(autoincrement())
  supplierId   String              @map("supplier_id") @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now()) @map("order_date") @db.Date
  expectedDate DateTime?           @map("expected_date") @db.Date
  subtotal     Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal     Decimal             @default(0) @map("tax_total") @db.Decimal(12, 2)
  total        Decimal             @default(0) @db.Decimal(12, 2)
  notes        String?             @db.VarChar(1000)
  createdById  String              @map("created_by") @db.Uuid
  approvedById String?             @map("approved_by") @db.Uuid
  approvedAt   DateTime?           @map("approved_at") @db.Timestamptz(3)
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]

  @@index([supplierId, orderDate])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  quantityOrdered  Int     @map("quantity_ordered")
  quantityReceived Int     @default(0) @map("quantity_received")
  /// Costo unitario sin impuesto.
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 4)
  taxRate          Decimal @map("tax_rate") @db.Decimal(5, 4)
  lineSubtotal     Decimal @map("line_subtotal") @db.Decimal(12, 2)
  lineTax          Decimal @map("line_tax") @db.Decimal(12, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems  PurchaseReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@map("purchase_order_items")
}

/// Recepción confirmada (inmutable): genera las entradas de inventario.
model PurchaseReceipt {
  id                    String   @id @default(uuid(7)) @db.Uuid
  number                Int      @unique @default(autoincrement())
  purchaseOrderId       String   @map("purchase_order_id") @db.Uuid
  supplierInvoiceNumber String?  @map("supplier_invoice_number") @db.VarChar(50)
  notes                 String?  @db.VarChar(1000)
  receivedById          String   @map("received_by") @db.Uuid
  receivedAt            DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String    @id @default(uuid(7)) @db.Uuid
  receiptId           String    @map("receipt_id") @db.Uuid
  purchaseOrderItemId String    @map("purchase_order_item_id") @db.Uuid
  lotId               String    @map("lot_id") @db.Uuid
  movementId          String    @unique @map("movement_id") @db.Uuid
  quantity            Int
  unitCost            Decimal   @map("unit_cost") @db.Decimal(12, 4)
  initialStatus       LotStatus @map("initial_status")

  receipt           PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  lot               Lot               @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("purchase_receipt_items")
}

// ─── Envíos (mensajerías y guías en la Fase 7) ───────────────────────────────

/// Tipo de envío ofrecido al cliente, con tarifa fija (D5).
model ShippingMethod {
  id                   String    @id @default(uuid(7)) @db.Uuid
  name                 String    @db.VarChar(100)
  description          String?   @db.VarChar(300)
  /// Costo para el cliente, con IVA incluido.
  cost                 Decimal   @db.Decimal(12, 2)
  estimatedDaysMin     Int?      @map("estimated_days_min")
  estimatedDaysMax     Int?      @map("estimated_days_max")
  coverageNote         String?   @map("coverage_note") @db.VarChar(300)
  allowsCashOnDelivery Boolean   @default(true) @map("allows_cash_on_delivery")
  /// Mensajería que lo atiende (opcional; se elige al despachar).
  courierId            String?   @map("courier_id") @db.Uuid
  isActive             Boolean   @default(true) @map("is_active")
  sortOrder            Int       @default(0) @map("sort_order")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  courier Courier? @relation(fields: [courierId], references: [id], onDelete: Restrict)
  orders  Order[]

  @@map("shipping_methods")
}

// ─── Carrito ─────────────────────────────────────────────────────────────────

/// Carrito del cliente. No guarda precios: se calculan al consultarlo.
model Cart {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer   @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ─── Pedidos ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_IN_REVIEW
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  DELIVERY_FAILED
  RETURNED_TO_STORE
  CANCELLED
  EXPIRED

  @@map("order_status")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH_ON_DELIVERY

  @@map("payment_method")
}

/// Pedido con copia de los datos comerciales del momento de la compra.
model Order {
  id                   String      @id @default(uuid(7)) @db.Uuid
  number               Int         @unique @default(autoincrement())
  customerId           String      @map("customer_id") @db.Uuid
  /// Clave enviada por el cliente: evita pedidos duplicados por doble envío.
  idempotencyKey       String      @map("idempotency_key") @db.Uuid
  status               OrderStatus
  placedAt             DateTime    @default(now()) @map("placed_at") @db.Timestamptz(3)
  /// Si el pedido sigue pendiente a esta hora, la reserva se libera.
  reservationExpiresAt DateTime?   @map("reservation_expires_at") @db.Timestamptz(3)

  customerName  String  @map("customer_name") @db.VarChar(201)
  customerEmail String  @map("customer_email") @db.VarChar(254)
  customerPhone String? @map("customer_phone") @db.VarChar(30)
  billingTaxId  String  @map("billing_tax_id") @db.VarChar(20)
  billingName   String  @map("billing_name") @db.VarChar(200)

  customerAddressId String? @map("customer_address_id") @db.Uuid
  shipRecipientName String  @map("ship_recipient_name") @db.VarChar(150)
  shipPhone         String  @map("ship_phone") @db.VarChar(30)
  shipAddressLine1  String  @map("ship_address_line1") @db.VarChar(200)
  shipAddressLine2  String? @map("ship_address_line2") @db.VarChar(200)
  shipZone          String? @map("ship_zone") @db.VarChar(20)
  shipMunicipality  String  @map("ship_municipality") @db.VarChar(100)
  shipDepartment    String  @map("ship_department") @db.VarChar(50)
  shipReference     String? @map("ship_reference") @db.VarChar(300)

  shippingMethodId   String  @map("shipping_method_id") @db.Uuid
  shippingMethodName String  @map("shipping_method_name") @db.VarChar(100)
  shippingCost       Decimal @map("shipping_cost") @db.Decimal(12, 2)
  shippingTax        Decimal @map("shipping_tax") @db.Decimal(12, 2)

  paymentMethod PaymentMethod @map("payment_method")
  currency      String        @default("GTQ") @db.Char(3)
  /// Suma de precios normales de las líneas (con IVA incluido).
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  /// IVA contenido en las líneas y el envío.
  taxTotal      Decimal       @map("tax_total") @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  customerNotes String?       @map("customer_notes") @db.VarChar(500)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?       @map("cancel_reason") @db.VarChar(500)
  /// Quién canceló (cliente o personal).
  cancelledById String?       @map("cancelled_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer        Customer             @relation(fields: [customerId], references: [userId], onDelete: Restrict)
  customerAddress CustomerAddress?     @relation(fields: [customerAddressId], references: [id], onDelete: Restrict)
  shippingMethod  ShippingMethod       @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  shipment        Shipment?
  returns         Return[]
  invoice         Invoice?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, placedAt(sort: Desc)])
  @@index([status, placedAt])
  @@index([placedAt])
  @@map("orders")
}

/// Línea del pedido: copia comercial inmutable del producto y sus importes.
model OrderItem {
  id                 String        @id @default(uuid(7)) @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  productId          String        @map("product_id") @db.Uuid
  sku                String        @db.VarChar(50)
  productName        String        @map("product_name") @db.VarChar(200)
  presentationLabel  String?       @map("presentation_label") @db.VarChar(100)
  concentrationLabel String?       @map("concentration_label") @db.VarChar(100)
  saleCondition      SaleCondition @map("sale_condition")
  /// Precio normal unitario, con IVA incluido.
  unitPrice          Decimal       @map("unit_price") @db.Decimal(12, 2)
  unitDiscount       Decimal       @default(0) @map("unit_discount") @db.Decimal(12, 2)
  /// Promoción aplicada al momento de la compra (la de mayor descuento).
  promotionId        String?       @map("promotion_id") @db.Uuid
  taxRate            Decimal       @map("tax_rate") @db.Decimal(5, 4)
  quantity           Int
  lineSubtotal       Decimal       @map("line_subtotal") @db.Decimal(12, 2)
  lineDiscount       Decimal       @default(0) @map("line_discount") @db.Decimal(12, 2)
  lineTax            Decimal       @map("line_tax") @db.Decimal(12, 2)
  lineTotal          Decimal       @map("line_total") @db.Decimal(12, 2)
  /// Unidades en devoluciones no rechazadas.
  quantityReturned   Int           @default(0) @map("quantity_returned")

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  promotion    Promotion?         @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  reservations StockReservation[]
  returnItems  ReturnItem[]
  invoiceItems InvoiceItem[]

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

/// Historial de estados del pedido (solo inserción). changedBy nulo = sistema.
model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by") @db.Uuid
  note        String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum ReservationStatus {
  ACTIVE
  /// Descontada del inventario al despachar (Fase 7).
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

/// Asignación FEFO de lotes a una línea de pedido: es la trazabilidad venta → lote.
model StockReservation {
  id                 String            @id @default(uuid(7)) @db.Uuid
  orderItemId        String            @map("order_item_id") @db.Uuid
  lotId              String            @map("lot_id") @db.Uuid
  quantity           Int
  status             ReservationStatus @default(ACTIVE)
  /// Movimiento SALE que la descontó al despachar.
  consumedMovementId String?           @unique @map("consumed_movement_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItem        OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  lot              Lot                @relation(fields: [lotId], references: [id], onDelete: Restrict)
  consumedMovement InventoryMovement? @relation(fields: [consumedMovementId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("stock_reservations")
}

// ─── Pagos (verificación y cobro en la Fase 7) ───────────────────────────────

enum PaymentStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

model Payment {
  id       String        @id @default(uuid(7)) @db.Uuid
  orderId  String        @map("order_id") @db.Uuid
  method   PaymentMethod
  status   PaymentStatus @default(PENDING)
  /// Monto esperado (total del pedido).
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("GTQ") @db.Char(3)
  /// MANUAL mientras no haya pasarelas.
  provider String        @default("MANUAL") @db.VarChar(30)

  // Transferencia: datos que registra el cliente.
  bankAccountId String?   @map("bank_account_id") @db.Uuid
  bankReference String?   @map("bank_reference") @db.VarChar(50)
  transferDate  DateTime? @map("transfer_date") @db.Date
  proofFileId   String?   @unique @map("proof_file_id") @db.Uuid
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(3)

  // Verificación manual (transferencia).
  verifiedById    String?   @map("verified_by") @db.Uuid
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(3)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)

  // Contra entrega: cobro registrado por el personal.
  collectedAmount Decimal?  @map("collected_amount") @db.Decimal(12, 2)
  collectedById   String?   @map("collected_by") @db.Uuid
  collectedAt     DateTime? @map("collected_at") @db.Timestamptz(3)
  collectionNote  String?   @map("collection_note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  bankAccount   BankAccount?           @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  proofFile     File?                  @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  statusHistory PaymentStatusHistory[]
  refunds       Refund[]

  @@index([status, createdAt])
  @@index([orderId])
  @@map("payments")
}

model PaymentStatusHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  paymentId   String         @map("payment_id") @db.Uuid
  fromStatus  PaymentStatus? @map("from_status")
  toStatus    PaymentStatus  @map("to_status")
  changedById String?        @map("changed_by") @db.Uuid
  note        String?        @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@map("payment_status_history")
}

// ─── Cuentas bancarias ───────────────────────────────────────────────────────

/// Cuenta de la farmacia para recibir transferencias.
model BankAccount {
  id            String    @id @default(uuid(7)) @db.Uuid
  bankName      String    @map("bank_name") @db.VarChar(100)
  accountNumber String    @map("account_number") @db.VarChar(50)
  /// Monetaria, ahorro…
  accountType   String    @map("account_type") @db.VarChar(30)
  accountHolder String    @map("account_holder") @db.VarChar(150)
  currency      String    @default("GTQ") @db.Char(3)
  instructions  String?   @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  payments Payment[]

  @@map("bank_accounts")
}

// ─── Mensajerías y envíos ────────────────────────────────────────────────────

model Courier {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String    @db.VarChar(100)
  phone               String?   @db.VarChar(30)
  website             String?   @db.VarChar(200)
  /// URL de rastreo con {tracking} donde va el número de guía.
  trackingUrlTemplate String?   @map("tracking_url_template") @db.VarChar(300)
  /// Identificador para una futura integración por API.
  integrationCode     String?   @map("integration_code") @db.VarChar(50)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  shippingMethods ShippingMethod[]
  shipments       Shipment[]

  @@map("couriers")
}

enum ShipmentStatus {
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED

  @@map("shipment_status")
}

enum ShipmentEventSource {
  MANUAL
  API

  @@map("shipment_event_source")
}

/// Envío del pedido con una mensajería externa. Se crea al despachar.
model Shipment {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @unique @map("order_id") @db.Uuid
  courierId      String         @map("courier_id") @db.Uuid
  trackingNumber String?        @map("tracking_number") @db.VarChar(100)
  /// Costo real que cobra la mensajería a la farmacia.
  courierCost    Decimal?       @map("courier_cost") @db.Decimal(12, 2)
  status         ShipmentStatus @default(DISPATCHED)
  dispatchedAt   DateTime       @default(now()) @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  receivedByName String?        @map("received_by_name") @db.VarChar(150)
  notes          String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courier Courier         @relation(fields: [courierId], references: [id], onDelete: Restrict)
  events  ShipmentEvent[]

  @@index([status])
  @@map("shipments")
}

/// Seguimiento del envío (manual por ahora; API cuando haya integración).
model ShipmentEvent {
  id          String              @id @default(uuid(7)) @db.Uuid
  shipmentId  String              @map("shipment_id") @db.Uuid
  status      ShipmentStatus
  description String              @db.VarChar(300)
  location    String?             @db.VarChar(150)
  occurredAt  DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(3)
  source      ShipmentEventSource @default(MANUAL)
  createdById String?             @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// ─── Devoluciones y reembolsos ───────────────────────────────────────────────

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  /// Unidades recibidas en la farmacia, pendientes de inspección.
  RECEIVED
  /// Todas las unidades inspeccionadas.
  CLOSED

  @@map("return_status")
}

enum ReturnDisposition {
  PENDING_INSPECTION
  /// Vuelve al lote original (movimiento RETURN_RESTOCK).
  RESTOCK
  DESTROY
  RETURN_TO_SUPPLIER

  @@map("return_disposition")
}

/// Devolución registrada por el personal (D7).
model Return {
  id             String       @id @default(uuid(7)) @db.Uuid
  number         Int          @unique @default(autoincrement())
  orderId        String       @map("order_id") @db.Uuid
  status         ReturnStatus @default(REQUESTED)
  reason         String       @db.VarChar(500)
  notes          String?      @db.VarChar(1000)
  createdById    String       @map("created_by") @db.Uuid
  decidedById    String?      @map("decided_by") @db.Uuid
  decidedAt      DateTime?    @map("decided_at") @db.Timestamptz(3)
  rejectedReason String?      @map("rejected_reason") @db.VarChar(500)
  receivedById   String?      @map("received_by") @db.Uuid
  receivedAt     DateTime?    @map("received_at") @db.Timestamptz(3)
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("returns")
}

model ReturnItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  returnId       String            @map("return_id") @db.Uuid
  orderItemId    String            @map("order_item_id") @db.Uuid
  /// Lote de origen (de la reserva consumida en el despacho).
  lotId          String            @map("lot_id") @db.Uuid
  quantity       Int
  conditionNotes String?           @map("condition_notes") @db.VarChar(500)
  disposition    ReturnDisposition @default(PENDING_INSPECTION)
  inspectedById  String?           @map("inspected_by") @db.Uuid
  inspectedAt    DateTime?         @map("inspected_at") @db.Timestamptz(3)
  /// Solo si se reincorporó al inventario.
  movementId     String?           @unique @map("movement_id") @db.Uuid

  return    Return             @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  lot       Lot                @relation(fields: [lotId], references: [id], onDelete: Restrict)
  movement  InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

enum RefundMethod {
  BANK_TRANSFER
  CASH

  @@map("refund_method")
}

enum RefundStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("refund_status")
}

model Refund {
  id            String       @id @default(uuid(7)) @db.Uuid
  paymentId     String       @map("payment_id") @db.Uuid
  returnId      String?      @map("return_id") @db.Uuid
  amount        Decimal      @db.Decimal(12, 2)
  method        RefundMethod
  reference     String?      @db.VarChar(100)
  reason        String       @db.VarChar(500)
  status        RefundStatus @default(PENDING)
  createdById   String       @map("created_by") @db.Uuid
  processedById String?      @map("processed_by") @db.Uuid
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  return  Return? @relation(fields: [returnId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

// ─── Facturación (sin FEL; datos FEL registrados manualmente, D11) ───────────

enum InvoiceKind {
  /// Comprobante interno: no constituye factura ni documento tributario.
  INTERNAL_RECEIPT
  /// Reservado para la integración con un certificador FEL.
  FEL

  @@map("invoice_kind")
}

enum InvoiceStatus {
  ISSUED
  VOIDED

  @@map("invoice_status")
}

enum FelStatus {
  /// La FEL aún no se registra (se emite en el portal del certificador).
  PENDING
  /// Datos de la FEL emitida registrados.
  CERTIFIED
  /// No corresponde (p. ej. comprobante anulado antes de emitir la FEL).
  NOT_APPLICABLE

  @@map("fel_status")
}

/// Documento de venta del pedido. Mientras no haya integración FEL es un
/// comprobante interno; los datos de la FEL emitida externamente se registran aquí.
model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  number          Int           @unique @default(autoincrement())
  orderId         String        @unique @map("order_id") @db.Uuid
  kind            InvoiceKind   @default(INTERNAL_RECEIPT)
  status          InvoiceStatus @default(ISSUED)
  issuedAt        DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  issuedById      String?       @map("issued_by") @db.Uuid
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason      String?       @map("void_reason") @db.VarChar(500)
  voidedById      String?       @map("voided_by") @db.Uuid
  customerTaxId   String        @map("customer_tax_id") @db.VarChar(20)
  customerName    String        @map("customer_name") @db.VarChar(200)
  customerAddress String?       @map("customer_address") @db.VarChar(500)
  currency        String        @default("GTQ") @db.Char(3)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @map("discount_total") @db.Decimal(12, 2)
  taxTotal        Decimal       @map("tax_total") @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)

  felStatus            FelStatus @default(PENDING) @map("fel_status")
  felAuthorizationUuid String?   @unique @map("fel_authorization_uuid") @db.Uuid
  felSeries            String?   @map("fel_series") @db.VarChar(50)
  felNumber            String?   @map("fel_number") @db.VarChar(50)
  felCertifier         String?   @map("fel_certifier") @db.VarChar(100)
  felCertifiedAt       DateTime? @map("fel_certified_at") @db.Timestamptz(3)
  felRegisteredById    String?   @map("fel_registered_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items InvoiceItem[]

  @@index([status, issuedAt])
  @@index([felStatus])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  orderItemId String? @map("order_item_id") @db.Uuid
  description String  @db.VarChar(300)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  /// Bien o servicio (lo exige FEL); el envío es un servicio.
  isGood      Boolean @map("is_good")

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ─── Promociones ─────────────────────────────────────────────────────────────

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("promotion_type")
}

/// Descuento sobre el precio normal de los productos participantes. Si un
/// producto tiene varias vigentes se aplica solo la de mayor descuento.
model Promotion {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String        @db.VarChar(150)
  description String?       @db.VarChar(500)
  type        PromotionType
  /// Porcentaje (1–100) o monto en quetzales por unidad.
  value       Decimal       @db.Decimal(12, 2)
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime      @map("ends_at") @db.Timestamptz(3)
  isActive    Boolean       @default(true) @map("is_active")
  createdById String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  products   PromotionProduct[]
  orderItems OrderItem[]

  @@index([startsAt, endsAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String @map("promotion_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

// ─── Notificaciones y auditoría ──────────────────────────────────────────────

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  STAFF_TRANSFER_TO_VERIFY
  STAFF_INVENTORY_DIGEST

  @@map("notification_type")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

/// Bandeja de salida de correos: se encola en la transacción del evento y un
/// proceso en segundo plano la envía con reintentos.
model NotificationLog {
  id            String             @id @default(uuid(7)) @db.Uuid
  type          NotificationType
  recipient     String             @db.VarChar(254)
  /// Datos del evento al encolarse; el correo se arma al enviarse.
  payload       Json               @db.JsonB
  /// Asunto del último envío (se completa al enviar).
  subject       String?            @db.VarChar(300)
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?            @map("last_error") @db.VarChar(1000)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(3)
  relatedType   String?            @map("related_type") @db.VarChar(30)
  relatedId     String?            @map("related_id") @db.Uuid
  /// Evita encolar dos veces el mismo aviso (p. ej. el resumen diario).
  dedupeKey     String?            @unique @map("dedupe_key") @db.VarChar(100)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([relatedType, relatedId])
  @@index([createdAt])
  @@map("notification_logs")
}

/// Registro de auditoría: solo inserción (trigger).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  /// Nulo en intentos de inicio de sesión con un correo inexistente.
  userId     String?  @map("user_id") @db.Uuid
  /// Operación (nombre del endpoint o evento, p. ej. update, approve, LOGIN).
  action     String   @db.VarChar(60)
  module     String   @db.VarChar(40)
  /// Método y ruta, p. ej. "PUT /admin/products/:id".
  route      String?  @db.VarChar(200)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  /// Datos enviados (sin secretos) y, cuando aplica, valores antes/después.
  changes    Json?    @db.JsonB
  statusCode Int?     @map("status_code")
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
