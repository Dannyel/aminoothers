# Copiar a .env (desarrollo) y a .env.test (pruebas e2e, con otra base de datos).
NODE_ENV=development
PORT=3000

# PostgreSQL local en 5432, o el de docker-compose en 5433.
DATABASE_URL="postgresql://farmacia:CAMBIAR@localhost:5432/farmacia_dev?schema=public"
# Solo para `prisma migrate dev`.
SHADOW_DATABASE_URL="postgresql://farmacia:CAMBIAR@localhost:5432/farmacia_shadow?schema=public"

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
# URL pública del frontend (enlaces de los correos).
FRONTEND_URL=http://localhost:5173

# Secreto para firmar los access tokens (mínimo 32 caracteres): openssl rand -hex 32
JWT_ACCESS_SECRET=CAMBIAR
# Clave para cifrar los secretos del doble factor: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=CAMBIAR
# MFA_ISSUER="Farmacia en línea"      (nombre en la app autenticadora)

# Correo. En desarrollo "log" escribe los correos en la consola; en producción
# es obligatorio "smtp".
MAIL_TRANSPORT=log
MAIL_FROM="Farmacia en línea <no-responder@farmacia.local>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Opcionales (valores por defecto entre paréntesis):
# SWAGGER_ENABLED=true            (true fuera de producción, false en producción)
# TRUST_PROXY=loopback            (de dónde se acepta X-Forwarded-For; ver docs)
# THROTTLE_TTL_MS=60000           (ventana del rate limiting)
# THROTTLE_LIMIT=120              (peticiones por IP en la ventana)
# AUTH_THROTTLE_LIMIT=10          (login, registro y recuperación, por IP y minuto)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_CUSTOMER_DAYS=30
# REFRESH_TTL_STAFF_HOURS=12
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCK_MINUTES=15
# MAX_PROOF_UPLOAD_MB=5           (comprobantes de transferencia, imagen o PDF)
# RESERVATION_SWEEP_INTERVAL_SECONDS=300 (vencimiento de reservas; 0 lo desactiva)
# NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30 (envío de la bandeja de correos; 0 lo desactiva)
# INVENTORY_DIGEST_HOUR=7 (hora de Guatemala del resumen diario de inventario)

# Solo para `pnpm db:seed` cuando aún no existe un superadministrador:
# INITIAL_ADMIN_EMAIL=admin@farmacia.gt
# INITIAL_ADMIN_PASSWORD=          (mínimo 12 caracteres)
